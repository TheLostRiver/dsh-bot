# ============================================================
#  deepseek 自主运营 B 站 · 直播互动配置
#  复制为 .env 后填写。.env 已在 .gitignore 中，切勿提交。
# ============================================================

# ---------- 目标直播间（你的直播间，不是 AI 账号的） ----------
# 在直播间 URL 里取：live.bilibili.com/<这个数字>
BILI_ROOM_ID=0

# ---------- AI 独立账号的登录凭据 ----------
# 用 AI 账号登录 bilibili.com 后，F12 -> Application -> Cookies 里取
# SESSDATA 与 bili_jct 必填；buvid3 强烈建议填（降低风控）
BILI_SESSDATA=
BILI_BILI_JCT=
BILI_BUVID3=
# 可选：AI 账号的 UID，留空会自动通过接口查询
BILI_BOT_UID=

# ---------- DeepSeek ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=1.1
DEEPSEEK_MAX_TOKENS=400
DEEPSEEK_TIMEOUT=30

# ---------- 人设 ----------
# AI 账号在直播间的身份设定，越具体越好
PERSONA_NAME=小深
PERSONA_BIO=一个住在 B 站直播间里的 AI 粉丝，说话短、接梗快，偶尔嘴贫但不招人烦。
PERSONA_STYLE=口语化、像普通网友、不用书面语、不说"作为AI"、不重复对方原话
PERSONA_CATCHPHRASE=嘿嘿

# ---------- 触发策略 ----------
# 随机回复概率（0~1）：普通闲聊被抽中的比例，太高会刷屏被举报
REPLY_PROBABILITY=0.12
# 提问句（含问号）一定回复
REPLY_ON_QUESTION=true
# 命中这些人设名字/@ 时必回
ALIASES=小深,小深深,ai,机器人
# 忽略的消息（正则，逗号分隔），用来过滤纯刷屏
IGNORE_PATTERNS=^[0-9]{1,3}$,^(哈+|6+|awsl|233+)$,^\s*$

# ---------- 发送配额（独立账号的安全生命线，宁小勿大） ----------
SEND_MIN_INTERVAL=12
SEND_PER_MINUTE=3
SEND_PER_HOUR=25
SEND_PER_DAY=180
# 同一个观众两次被回复的最小间隔（秒）
USER_COOLDOWN=240
# 弹幕最大字数（普通账号约 20，超出会被拒发）
MAX_DANMAKU_LEN=20

# ---------- 语音 ----------
SPEECH_ENABLED=true
# file = 只生成 mp3（给 OBS 媒体源/播放器用）
# play = 本机直接播放（需要 sounddevice，配合 VB-Audio Cable 注入 OBS）
SPEECH_BACKEND=file
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=+8%
TTS_VOLUME=+0%
# 音调微调（+50Hz 更活泼，-50Hz 更低沉）；留空即默认
TTS_PITCH=+0Hz
# play 模式下指定输出设备序号（留空用系统默认）
SPEECH_DEVICE=

# ---------- 实时混音（麦克风 + AI 语音 → 一路） ----------
# 打开后，真人麦克风和 TTS 会被混成一路输出到指定设备，
# 直播姬/OBS 只选一个输入设备就能同时收到两边
SPEECH_MIX_ENABLED=false
# 麦克风设备序号（留空 = 系统默认）
SPEECH_MIX_INPUT=
# 输出设备序号（留空 = 跟随 SPEECH_DEVICE / 系统默认）；建议选虚拟声卡 CABLE Input
SPEECH_MIX_OUTPUT=
# 麦克风音量倍数
SPEECH_MIX_MIC_GAIN=1.0
# AI 语音音量倍数
SPEECH_MIX_TTS_GAIN=1.0
# 弹幕发不出去时也照样播报语音（账号被限制、发不出弹幕时至少还有声音）
SPEECH_WHEN_FAILED=false
# 直播软件（直播姬/OBS）里已开启「系统声音采集」
# 用系统默认输出播放时必须开，否则观众听不到；自检据此下结论
SPEECH_SYSTEM_AUDIO=false

# 闪避：AI 说话时把麦克风压低多少（0~1，0.85 表示压到 15%）
SPEECH_MIX_DUCK=0.85
# 语音最长字数（超长截断，防止 AI 念稿念半天）
SPEECH_MAX_CHARS=80

# ---------- 运行 ----------
# true 时只走完整决策流程但不真的发弹幕/不用真账号，用于调试
DRY_RUN=false
# 房间没开播时也工作：只播报、不发弹幕（开播前调试用）
OFFLINE_ENABLED=false
LOG_LEVEL=INFO

# ---------- 评论区值班 ----------
# 轮询主播视频下的新评论，用 AI 账号接话
COMMENT_ENABLED=false
# 0 = 从 BILI_ROOM_ID 自动推导主播 UID
COMMENT_UP_MID=0
# 盯最近几个视频
COMMENT_VIDEOS=5
# 每轮扫描间隔（秒）
COMMENT_POLL_INTERVAL=300
# 只回这么久以内的评论（小时），防止一上来把历史评论全回了
COMMENT_LOOKBACK_HOURS=72
# 每天最多回几条（评论回复比弹幕更招人烦，宁小勿大）
COMMENT_MAX_PER_DAY=20
# 两条回复最小间隔（秒）
COMMENT_MIN_INTERVAL=90
# 评论字数上限
COMMENT_MAX_LEN=60
# 普通评论被抽中的概率（提问、提到主播的必回）
COMMENT_REPLY_PROBABILITY=0.5

# ---------- 自动逛 B 站 ----------
# 按分区/关键词自己找视频，读字幕后决定要不要点赞/收藏/评论
BROWSE_ENABLED=false
# 每轮间隔（秒）
BROWSE_INTERVAL=1800
# 每轮挑几条候选
BROWSE_BATCH=6
# 每轮最多读几条字幕（烧 token 的大头，宁小勿大）
BROWSE_MAX_LLM=3
# 分区（RankType 名字，逗号分隔）：Game,Knowledge,Technology,Douga,Kichiku,Music,
#   Dance,Life,Food,Ent,Cinephile,Car,Sports,Animal,Documentary
BROWSE_ZONES=
# 关键词（逗号分隔）。留空则只看分区
BROWSE_KEYWORDS=
# 话题名（逗号分隔），逛话题页下的最新投稿，比如：怪物猎人,深夜食堂
BROWSE_TOPICS=
# 指定 UP 主 mid（逗号分隔），逛他们最近发的视频。不需要关注他们
BROWSE_UPS=
# 最短时长（秒），太短的不值得花 token 判断
BROWSE_MIN_DURATION=60
# 最低播放量。⚠️ 只对「分区/热门」生效 —— 话题和指定 UP 本来就冷门，不设门槛
BROWSE_MIN_PLAY=300
# 关键词模式下只逛几天内的
BROWSE_DAYS=7
# 排序：pubdate / click / dm
BROWSE_ORDER=pubdate
# 喂给模型的最大字幕字数
BROWSE_MAX_SUBTITLE_CHARS=6000
# 收藏夹名字（不存在会自动创建）
BROWSE_FAVORITE_FOLDER=AI 精选
# 点赞每日上限（默认开，风险低）
BROWSE_LIKE_PER_DAY=20
# 收藏每日上限（默认关，在后台里开）
BROWSE_FAV_PER_DAY=10
